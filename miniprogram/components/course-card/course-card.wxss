/* 课程卡片 · 杂志条目 */

.course-card {
  display: flex;
  gap: 24rpx;
  padding: 28rpx;
  background: #fffefa;
  border: 1rpx solid #e9e4d7;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(50, 46, 30, 0.05);
  transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.course-card.hover {
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 36rpx rgba(50, 46, 30, 0.1);
  background: #fff;
}

/* 首字色块（杂志首字下沉感） */
.course-mark {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-weight: 900;
  font-size: 40rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.55);
}

.course-body { flex: 1; min-width: 0; }
.course-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.course-head { min-width: 0; }
.course-type {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.course-name {
  display: block;
  font-size: 33rpx;
  font-weight: 800;
  margin-top: 10rpx;
  color: #20253a;
  letter-spacing: 1rpx;
}

/* 报名按钮 */
.enroll-btn {
  flex: none;
  min-width: 108rpx;
  margin: 0;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: 1rpx;
  border-radius: 14rpx;
  background: #3a5bd9;
  color: #fff;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(58, 91, 217, 0.25);
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.enroll-btn.btn-hover { transform: scale(0.94); box-shadow: none; }
.enroll-btn.disabled {
  background: #eef0f4;
  color: #a2a8b8;
  box-shadow: none;
}
.enroll-btn.enrolled {
  background: #dff2e2;
  color: #227a44;
  box-shadow: none;
}

.course-meta {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  color: #6b6353;
  font-size: 23rpx;
}
.course-desc {
  margin-top: 12rpx;
  color: #9a927e;
  font-size: 23rpx;
  line-height: 1.65;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 余位条 */
.seat-row { margin-top: 18rpx; display: flex; align-items: center; gap: 18rpx; }
.seat-track {
  flex: 1;
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #efebdd;
}
.seat-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #3a5bd9, #7a95ec);
  transition: width 0.4s ease;
}
.seat-text { color: #9a927e; font-size: 22rpx; flex: none; }
.seat-num { font-weight: 900; color: #20253a; font-size: 24rpx; }
.seat-num.low { color: #c14a30; }
