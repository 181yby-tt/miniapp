<view class="course-card" bindtap="onSelect" hover-class="hover">
  <view class="course-mark tone-{{tone}}">{{mark}}</view>
  <view class="course-body">
    <view class="course-top">
      <view class="course-head">
        <text class="course-type tone-{{tone}}">{{course.category}}</text>
        <text class="course-name">{{course.name}}</text>
      </view>
      <button class="enroll-btn {{disabled ? 'disabled' : ''}} {{enrolled ? 'enrolled' : ''}}" catchtap="onEnroll" disabled="{{disabled}}" hover-class="btn-hover">{{btnText}}</button>
    </view>
    <view class="course-meta">
      <text wx:if="{{teacherText}}">{{teacherText}}</text>
      <text wx:for="{{course.schedules}}" wx:key="time_slot_id">{{item.slot_name}}</text>
      <text wx:for="{{course.schedules}}" wx:key="time_slot_id">{{item.venue_name}}</text>
    </view>
    <view class="course-desc" wx:if="{{course.description}}">{{course.description}}</view>
    <view class="seat-row" wx:if="{{showSeat}}">
      <view class="seat-track"><view class="seat-fill" style="width:{{pct}}%"></view></view>
      <text class="seat-text">余 <text class="seat-num {{course.remaining <= 3 ? 'low' : ''}}">{{course.remaining}}</text>/{{course.capacity}}</text>
    </view>
  </view>
</view>
