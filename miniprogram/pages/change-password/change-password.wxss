/* 修改密码 */

.tip {
  background: #fbeed1;
  border: 1rpx solid #ecd6a3;
  color: #996700;
  font-size: 25rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.form { padding: 10rpx 30rpx; }
.field {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f1ecdf;
}
.field:last-child { border-bottom: none; }
.label {
  width: 180rpx;
  font-size: 26rpx;
  color: #6b6353;
  font-weight: 800;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.input {
  flex: 1;
  font-size: 29rpx;
  color: #20253a;
}

.submit { margin-top: 40rpx; height: 94rpx; line-height: 94rpx; }
