<view class="page">
  <view class="tip card" wx:if="{{isFirst}}">首次登录请先修改初始密码，以保障账号安全。</view>

  <view class="form card">
    <view class="field">
      <text class="label">原密码</text>
      <input class="input" placeholder="请输入原密码" password data-field="old_password" value="{{old_password}}" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">新密码</text>
      <input class="input" placeholder="至少 8 位，建议字母+数字" password data-field="new_password" value="{{new_password}}" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">确认新密码</text>
      <input class="input" placeholder="再次输入新密码" password data-field="confirm_password" value="{{confirm_password}}" bindinput="onInput" />
    </view>
  </view>

  <button class="btn-primary submit" loading="{{loading}}" bindtap="onSubmit">确认修改</button>
</view>
