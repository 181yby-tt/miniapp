# 解析到腾讯云香港服务器公网 IP 的域名，不要带 https://
DOMAIN=course.example.com

# 请分别生成高强度随机值，不要沿用示例
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
TOKEN_SECRET=replace-with-at-least-32-random-bytes

# 仅数据库第一次初始化时使用；首次登录后仍应立即修改
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-admin-password

# Web 版不依赖微信登录；若同一后端还要服务小程序，再填写
APPID=
APPSECRET=
