{
  "name": "kexu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @kexu/web",
    "build:web": "npm run build --workspace @kexu/web",
    "test:core": "npm test --workspace @kexu/client-core",
    "test:web": "node --test apps/web/test/*.test.js",
    "test": "npm run test:core && npm run test:web"
  }
}
