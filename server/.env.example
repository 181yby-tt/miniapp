# 课序后端 · 环境变量示例
# 复制为 .env 后填入真实值（.env 已在 .gitignore / .dockerignore 中，不会进仓库）。
# 只要配置了 DB_HOST，后端就会启用 MySQL / 云数据库持久化；否则回退到 data.json 文件模式。

# ---- MySQL / 云数据库（微信云托管「MySQL」实例或自建）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=kexu

# ---- 可选：首次种子管理员账号（仅库为空时生效）----
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=demo123456

# ---- 服务端口（微信云托管默认注入 PORT=80）----
# PORT=3000
