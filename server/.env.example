# 课序后端 · 环境变量示例
# 复制为 .env 后填入真实值（.env 已在 .gitignore / .dockerignore 中，不会进仓库）。
# DB_MODE 可选 file / cloudbase_mysql / mysql；未配置时有 DB_HOST 则使用 mysql，否则使用 file。

# ---- CloudBase MySQL SDK 网关（免费版/个人版推荐）----
# CLOUDBASE_APIKEY 应由云托管控制台「API key 设置」安全注入，不要写入本文件或源码。
DB_MODE=cloudbase_mysql
CLOUDBASE_ENV_ID=app-d2gqxo7iof3a0d7ce
CLOUDBASE_MYSQL_TABLE=app_snapshots

# ---- MySQL TCP 直连（标准版 VPC / 本地开发）----
# DB_MODE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=change-me
# DB_NAME=kexu

# ---- 可选：首次种子管理员账号（仅库为空时生效）----
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=demo123456

# ---- 服务端口（容器内使用非特权端口；外部仍通过 HTTPS 443 访问）----
PORT=8080
# PORT=3000
# 容器文件模式可指向可写临时目录；生产应使用 cloudbase_mysql 或 mysql
# DATA_FILE=/tmp/kexu-data.json

# ---- 微信小程序凭证（务必通过环境变量注入，切勿硬编码进源码）----
# 本地开发复制本文件为 .env 并填入真实值；.env 已被 gitignore，不会进仓库。
APPID=wxYOUR_APPID
APPSECRET=your_appsecret_here
TOKEN_SECRET=change-me-to-a-long-random-string
